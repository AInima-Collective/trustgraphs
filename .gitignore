# general compile
/target
# Rust build dirs for the detached zk/ workspaces (guest + host) and any nested crate.
**/target/
# Generated outputs (prover proofs/blobs, exporter inputs, witness archives) — one home.
.trustgraph/
# `task demo` scratch: operator config, request journal, status and run log. Chain-specific — a
# journal committed here would refuse to work on anyone else's chain.
.demo/
out/
cache/
broadcast/
node_modules/
.pnpm-store/

# Env
.env
.env.*
!.env.example
.env-e

# Local deploy node artifacts (incl. deployer key material)
.nodes/

# Tools
**/.claude/settings.local.json
.task

# Claude Code
anvil
cast
chisel
forge
foundry_nightly_linux_arm64.tar.gz

# Misc
.DS_Store
schema_output.log
contracts/deploy/post-deploy.sh
# Human-seeded, deploy-mutated config (like foundry.toml) — stays at repo root.
params.json
params.contributions.json
# `task demo:contributions` provisions its own copy from the template; the deploy writes the
# registered schema UIDs back into it, so it is machine-local state.
params.contributions.demo.json

# Deploy
config/*_deploy_*.json
config/networks.development.json
.docker/*.json
.docker/*.log
.docker/*.env
tests/e2e/deploy.json

# Editor-specific workspace settings
.vscode/

# Real-repo fixture CARs are re-fetchable (see tests/fixtures/atproto/repos/README.md);
# only the small hypercerts fixture CAR is committed.
tests/fixtures/atproto/repos/*.car
tests/fixtures/atproto/hypercerts/gen/node_modules/

# Downloaded per release by the deploy planner (see requireReleaseVkeys). Never commit it:
# a checked-in vkey table is one more thing a local build can overwrite.
guest-manifest.json

# Operator-created database dumps and restore-drill artifacts are durable deployment data, not
# source. Keep them outside git even when the backup script uses its local default directory.
backups/
