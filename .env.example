# ─── Deploy ──────────────────────────────────────────────────────────────────
# Stage controls validation strictness; target selects the chain profile.
DEPLOY_STAGE=development
DEPLOY_TARGET=local

# 31337 for local, 11155111 for Sepolia
CHAIN_ID=31337
# Direct Forge scripts use EXPECTED_CHAIN_ID when set, otherwise CHAIN_ID. The TypeScript deployer
# always injects the selected profile's chain ID.
# EXPECTED_CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com/

# ─── Indexer ────────────────────────────────────────────────────────────────
# Local Ponder uses RPC_URL by default. These explicit values are useful when the deployer and
# indexer reach the same chain through different endpoints.
# PONDER_RPC_URL_31337=http://127.0.0.1:8545
# PONDER_WS_URL_31337=ws://127.0.0.1:8545
# PONDER_START_BLOCK=1

# Sepolia release consumers read addresses and the default start block from
# deployments/sepolia.json. RPC credentials stay only in the environment.
# PONDER_RPC_URL_11155111=https://...
# PONDER_WS_URL_11155111=wss://...
# PONDER_START_BLOCK_11155111=
# Use a NEW writer schema for each release. `trust-graph` is the stable read/views schema.
# PONDER_DATABASE_SCHEMA=trustgraph_v1
# PONDER_VIEWS_SCHEMA=trust-graph

# Explicit deployer key. `pnpm deploy:create-deployer` writes a fresh funded local key. There is no
# script fallback, and the known Anvil default key is rejected on public chains.
FUNDED_KEY=

# ─── ZK deploy constants ─────────────────────────────────────────────────────
# The root is proven by SP1 (see ZK_ARCHITECTURE.md). These pin "what is correct" on-chain and are
# read by contracts/deploy/env.ts. In DEV they default to zero (scaffolding); for a real deploy set them all.
#
# FOR ANY DEPLOY THAT MATTERS, TAKE THESE FROM A RELEASE, NOT FROM A LOCAL BUILD.
# A guest built the plain way is not reproducible: a toolchain reinstall has been observed to shift
# vkeys with zero source change, and these get pinned into a verifier that can never be edited.
# Every release publishes guest-manifest.json, built by a public workflow from a public commit and
# agreed on by two cold runners before it ships:
#
#   gh release download v0.0.4 -R AInima-Collective/trustgraphs -p guest-manifest.json
#   jq -r '.programs[] | "\(.program) \(.vkey)"' guest-manifest.json
#
# v0.0.4 (commit 95faa6f):
#   SP1_PROGRAM_VKEY             = 0x003c8e19b8e12c260e5450a068c61460180b5cf93f03dc1214187a9ad3bdde5e
#   SP1_SIGNER_PROGRAM_VKEY      = 0x00d1b981df6bee1682be2b212151d2ac74c30108215d8e949a84a604ae4baadb
#   SP1_WEIGHTED_PROGRAM_VKEY    = 0x0027625a41e9d165ab50ca4ff9afbc134385b99688a5fd69cdf03d5056f5abb2
#   SP1_COMPOSITION_PROGRAM_VKEY = 0x00e2847cc257d916a6422283094e8764296045e5f9ed8805b7aaa9b3dd6f7aed
#   CONTRIBUTIONS_PROGRAM_VKEY   = 0x0083cb62532a5c855c0c1b61a1eb7b7d5d6d924784342ea661c80baf79cfa243
#   HYPERCERTS_PROGRAM_VKEY      = 0x009890d8fed8be4836e060c25ad267049efbe79ce929b0e63c1e086007008d40
#   NOSTR_WORKSPACE_VKEY         = 0x003a7984610aa854a8daa012d2d78846ba663781c8fe3aa74fed99be047b6566
#
# The local equivalents, for DEV ONLY. These answer "what did this machine build", which is a
# useful question and not the one a verifier is pinned to:
#   SP1_PROGRAM_VKEY             = cargo run -p trustgraph-prover -- trust-graph vkey
#   SP1_SIGNER_PROGRAM_VKEY      = cargo run -p trustgraph-prover -- signer vkey
#   SP1_WEIGHTED_PROGRAM_VKEY    = cargo run -p trustgraph-prover -- trust-graph-weighted vkey
#   SP1_COMPOSITION_PROGRAM_VKEY = cargo run -p trustgraph-prover -- trust-compose vkey
#   CONTRIBUTIONS_PROGRAM_VKEY   = cargo run -p trustgraph-prover -- contributions vkey
#   HYPERCERTS_PROGRAM_VKEY      = cargo run -p trustgraph-prover -- hypercerts vkey
#   NOSTR_WORKSPACE_VKEY         = cargo run -p trustgraph-prover -- nostr-workspace vkey
#
# The weighted and composition vkeys gate their factory deploy steps: `pnpm deploy:contracts`
# fails closed when either is unset, because DeployZkVerifier's zero-vkey fallback is
# SP1_PROGRAM_VKEY (the ROOT program) and a weighted/compose verifier silently pinned to the root
# vkey could never verify its own program's proofs. `task demo:deploy` derives all of them from
# this checkout's guests, so the demo path never needs them set here.
#
# There is NO PARAMS_HASH here: DeployNetwork computes it on-chain from params.json (the same file the
# prover feeds the guest) right after it registers the schema — ParamsCodec.hash() is byte-identical to
# the guest's params_hash (golden-tested). Point at a non-default params file with PARAMS_JSON=/path.
SP1_PROGRAM_VKEY=
# SHA-256 of the exact trust-graph ELF archived for the release manifest.
SP1_PROGRAM_ELF_SHA256=
SP1_SIGNER_PROGRAM_VKEY=
SP1_WEIGHTED_PROGRAM_VKEY=
SP1_COMPOSITION_PROGRAM_VKEY=
CONTRIBUTIONS_PROGRAM_VKEY=
# Recorded for release/manifest parity. Hypercerts is not hosted by the current operator, and a
# Nostr workspace is deployed only with an explicit pilot identity plus immutable witness archives.
HYPERCERTS_PROGRAM_VKEY=
NOSTR_WORKSPACE_VKEY=

# Prior/policy rotation review windows for the weighted and compose factories, in seconds.
# Immutable at factory deploy. contracts/deploy/env.ts defaults both to 300 locally; the deploy scripts
# refuse anything under one day on a non-dev chain (the delay is the window in which proving
# operators re-verify a proposed prior's or policy's exact bytes — see the weighted-prior and
# composition runbooks).
# WEIGHTED_PRIOR_ACTIVATION_DELAY=
# COMPOSE_POLICY_ACTIVATION_DELAY=

# Succinct's canonical SP1 verifier gateway on the target chain (present in a mainnet-fork anvil).
# This is the mainnet *Groth16* gateway (the repo proves --groth16); it's a router that carries the
# verifier for the SDK version this repo pins (v6.3.1). Same CREATE2 address across chains.
# Verify / find others: https://docs.succinct.xyz/docs/sp1/verification/contract-addresses
# (PLONK gateway, if ever needed, is 0x3B6041173B80E77f038f3F2C0f9744f04837185e.)
SP1_VERIFIER_GATEWAY=0x397A5f7f3dBd538f23DE225B51f532c34448dA9B

# Public release inputs (required for production/sepolia dry-run and deployment).
# INSTANCE_REGISTRY_ADMIN=0x...
# FACTORY_EPOCH_FLOOR=7200
# ETH_USD_FEED=0x...
# USDC=0x...
# DEPLOYMENT_COMMIT=<40-hex git commit>
# SKIP_PROVING_VAULT=true

# ─── Contributions instance (contracts/script/DeployContributionsInstance.s.sol) ───────
# The contributions guest image id: cargo run -p trustgraph-prover -- contributions vkey.
# Unset/zero = dev scaffolding: the deploy stands the instance up with a MockSP1Gateway (accept-all
# at the SNARK seam) so SP1_PROVER=mock proofs submit locally. Set BOTH this and
# SP1_VERIFIER_GATEWAY for any deploy that matters.
# CONTRIBUTIONS_PROGRAM_VKEY is declared with the other release vkeys above.
# Round cadence in blocks between contrib MerkleSnapshot triggers (default 10 for dev).
# CONTRIBUTIONS_EPOCH_LENGTH=
# Contributions params file (default params.contributions.json); the deploy writes the freshly
# registered schema UIDs back into it so the prover stays in sync.
# CONTRIBUTIONS_PARAMS_JSON=
# TestUSDC (6 decimals) minted to the deployer for the dev funding pool (default 1,000,000 tUSDC).
# CONTRIBUTIONS_POOL_MINT=

# Governance timelocks. Proposers default to the deployer and the executor defaults to the
# deployer, but production requires an independent canceller for each tier. A proposer and its
# tier's canceller must be different. DEV uses Anvil account #1 for both canceller duties unless
# overridden; there is deliberately no production canceller fallback.
# TIMELOCK_PROPOSER=
# CONSTITUTIONAL_TIMELOCK_PROPOSER=
# CONSTITUTIONAL_TIMELOCK_CANCELLER=
# OPERATIONAL_TIMELOCK_PROPOSER=
# OPERATIONAL_TIMELOCK_CANCELLER=
# TIMELOCK_EXECUTOR=
# CONSTITUTIONAL_DELAY=
# OPERATIONAL_DELAY=

# ─── Proving backend (read by the SP1 SDK when you run `prove`) ───────────────
# network = Succinct prover network (no big machine); cpu = local (~16-32 GiB + `--features native-gnark`).
# Local CPU testing uses `cpu` — build the prover with `--features native-gnark` and a Go/gnark toolchain.
SP1_PROVER=cpu
# Required for SP1_PROVER=network only (leave blank for cpu):
NETWORK_PRIVATE_KEY=
# Pays submit gas for MerkleSnapshot.submitProof. Deliberately separate from the key above: the
# payee is named in the proof journal, so this one never needs to hold value beyond gas and is
# freely rotatable. The operator daemon reads it; nothing else does.
SUBMITTER_PRIVATE_KEY=

# ─── Local mainnet fork (research/operations/trust-graph/local-testing.md) ───────────────────────────────────
# Archive-capable mainnet RPC to fork, so Succinct's real SP1 gateway is in local state.
# Used by taskfile/services.yml's fork toggle; or run `anvil --fork-url "$FORK_RPC_URL"` directly.
FORK_RPC_URL=

# ─── Hosted services (Sepolia) ───────────────────────────────────────────────
# Only needed when the indexer, frontend and operator run as deployed services rather than
# locally. Every value here is a credential or a public URL: none of them belong in
# deployments/sepolia.json, and the manifest validator rejects secret-shaped keys on purpose.

# Indexer. Ponder needs Postgres; the writer and the read-only server share one database and are
# separate processes, which is what lets the public API keep serving the last completed views
# schema while a backfill runs. Use a NEW writer schema per release.
# DATABASE_URL=postgresql://user:password@host:5432/ponder
# PONDER_PORT=42069
# PONDER_DATABASE_SCHEMA=trustgraph_sepolia_v1
# PONDER_VIEWS_SCHEMA=trust-graph

# Frontend, server side only. These are read in route handlers and never shipped to the browser,
# which is the point: NEXT_PUBLIC_* values are public by definition, so the paid RPC key must not
# be one. Browser reads fail over between the explicitly numbered RPC variables;
# `RPC_URL_11155111` is the independent primary used by the service stack.
# RPC_URL_1=https://... # Ethereum mainnet, for ENS reads only
# RPC_URL_11155111=https://...
# RPC_URL_11155111_0=https://...
# RPC_URL_11155111_1=https://...
# PONDER_URL=https://ponder.testnet.example.org
# IPFS_GATEWAY_PUBLIC=https://gateway.example.org/ipfs/
# FRONTEND_URL=https://trustgraphs.xyz
# Featured homepage graph: instance id, configured slug, or Merkle snapshot address.
# FEATURED_NETWORK_ID=0x...
# IPFS_PIN_API=https://uploads.pinata.cloud/v3/files
# IPFS_PIN_API_KEY=
# The metadata pin route enforces these per-process and per-IP hourly quotas after an exact
# browser-origin check. Counters reset on process restart/serverless cold start and are not shared
# across replicas. Put a shared edge limiter in front of hosted deployments; this is only the
# in-process fail-safe. Per-IP enforcement trusts x-forwarded-for only when the edge proxy
# overwrites that header rather than accepting a client-supplied value. The webhook fires once per
# process window at 80% of the global cap.
# IPFS_PIN_ALLOWED_ORIGINS=https://trustgraphs.xyz
# IPFS_PIN_PER_IP_HOURLY_QUOTA=5
# IPFS_PIN_GLOBAL_HOURLY_QUOTA=100
# IPFS_PIN_QUOTA_ALERT_WEBHOOK=https://...
# The operator's read-only heartbeat, which the app renders as score freshness. Point it at the
# operator service's /status route; PATH is for when it is served under a prefix.
# OPERATOR_STATUS_URL=https://operator.example/status
# OPERATOR_STATUS_PATH=

# Optional: the sponsored-attestation relay, if enabled for the deployment.
# EAS_RELAY_RPC_URL=
# EAS_RELAY_PRIVATE_KEY=
# EAS_RELAY_ADDRESS=
# EAS_RELAY_CHAIN_ID=11155111
# EAS_RELAY_SCHEMA_ALLOWLIST=

# Contract verification. NOTE: this repo has no verification tooling wired up yet — no --verify in
# the deploy pipeline and no etherscan block in foundry.toml. The key is listed because it has to
# be obtained; the step that uses it is still to be built.
# ETHERSCAN_API_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# SEPOLIA RELEASE — reference values for the ignored .env.sepolia overlay
# ═════════════════════════════════════════════════════════════════════════════
# Every value already filled in here is public: addresses, a commit, and vkeys from a published
# release. Secret and hosted-service values remain blank and belong in the deployment's secret
# manager as well as the ignored local overlay.
# Keep `.env` on development/local. Public commands opt into this ignored overlay with
# `DEPLOY_TARGET=sepolia`; the shared loader fails closed if the overlay is absent.
#
# NOT set here, deliberately: ETH_USD_FEED and USDC. Both fall back to deployments/sepolia.json,
# which already carries Sepolia's canonical EAS, schema registry, SP1 gateway, Chainlink ETH/USD
# feed and USDC. Setting them by hand only creates a second source that can disagree.

# DEPLOY_STAGE=production
# DEPLOY_TARGET=sepolia
# CHAIN_ID=11155111

# --- transaction credentials --------------------------------------------------------------
# Your paid Sepolia endpoint. The indexer needs the same one (PONDER_RPC_URL_11155111 below).
# RPC_URL=
# The deployer's private key: 0x57cFdD9115da5DfB1C5Fc1E8Fe622C030E67bD30, funded with 0.5 ETH,
# nonce 0. Hot, signs the whole broadcast session, renounces its roles at the end.
# FUNDED_KEY=
# Pays submit gas only, never holds protocol authority. Rotatable. The funded public address is
# 0xf6161E3c1e83EF8297690153120462633570B8D1.
# SUBMITTER_PRIVATE_KEY=

# --- the release being deployed -----------------------------------------------------------
# v0.0.5, built by a public workflow and agreed on by two cold runners. Do NOT substitute a
# locally derived vkey: a plain guest build is not reproducible, and these get pinned into a
# verifier that can never be edited.
# DEPLOYMENT_COMMIT=f64a4c7c9b5e552e2392894a2e0d6f6c40973549
# SP1_PROGRAM_VKEY=0x003c8e19b8e12c260e5450a068c61460180b5cf93f03dc1214187a9ad3bdde5e
# SP1_SIGNER_PROGRAM_VKEY=0x00d1b981df6bee1682be2b212151d2ac74c30108215d8e949a84a604ae4baadb
# SP1_WEIGHTED_PROGRAM_VKEY=0x0027625a41e9d165ab50ca4ff9afbc134385b99688a5fd69cdf03d5056f5abb2
# SP1_COMPOSITION_PROGRAM_VKEY=0x00e2847cc257d916a6422283094e8764296045e5f9ed8805b7aaa9b3dd6f7aed
# CONTRIBUTIONS_PROGRAM_VKEY=0x0083cb62532a5c855c0c1b61a1eb7b7d5d6d924784342ea661c80baf79cfa243
# Note the 0x prefix: the validator requires ^0x[0-9a-f]{64}$, and the release notes print the
# digest bare.
# SP1_PROGRAM_ELF_SHA256=0x1ad727e35139b7db669430052a376b6850352c2fc5792a0f6815c7da21b7059d

# --- custody and policy -------------------------------------------------------------------
# The admin EOA. Holds ProvingVault administrator and fee-setter, and proposer plus executor on
# the registry timelock.
# INSTANCE_REGISTRY_ADMIN=0x45CbC00e0618880bfB2dBDdEAed1ef1411dd5eeE
# ~1 day at 12s blocks. The single biggest cost lever: it caps each network at about one proof
# per day.
# FACTORY_EPOCH_FLOOR=7200
# Minimum one-day review windows for the two mutable program policies. Both default to 86400 on
# Sepolia; set them explicitly when rehearsing the exact public inputs.
# WEIGHTED_PRIOR_ACTIVATION_DELAY=86400
# COMPOSE_POLICY_ACTIVATION_DELAY=86400

# --- proving ------------------------------------------------------------------------------
# SP1_PROVER=network
# The Succinct prover network requester key, which needs PROVE credit.
#
# CAUTION, and see research/DEVIATIONS.md decision 41: this key lives in the OPERATOR SERVICE's
# environment, on a long-running box. Using the admin EOA's key here puts registry-timelock and
# vault-admin authority on that box, which is the separation the custody decision exists to
# rehearse. A dedicated requester key costs nothing and keeps the admin off the container.
# NETWORK_PRIVATE_KEY=

# --- indexer ------------------------------------------------------------------------------
# PONDER_RPC_URL_11155111=
# Optional comma/newline-delimited failovers. Keep provider credentials out of tracked files.
# PONDER_RPC_URLS_11155111=https://ethereum-sepolia-rpc.publicnode.com
# Tune this for the strictest endpoint in the pool. The conservative default is 10 blocks.
# PONDER_ETH_GET_LOGS_BLOCK_RANGE_11155111=10
# PONDER_START_BLOCK_11155111=
# PONDER_DATABASE_SCHEMA=trustgraph_sepolia_v1
# PONDER_VIEWS_SCHEMA=trust-graph
