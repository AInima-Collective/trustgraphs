# Local development. If omitted, the indexer uses the repository-level RPC_URL and then
# http://127.0.0.1:8545. PONDER_START_BLOCK must be at or before every indexed deployment/event.
# PONDER_RPC_URL_31337=http://127.0.0.1:8545
# PONDER_WS_URL_31337=ws://127.0.0.1:8545
# PONDER_START_BLOCK=1
# Optional until the isolated weighted factory is deployed. Its controller, resolver, and snapshot
# children are then discovered from factory events with no per-instance address list.
# WEIGHTED_FACTORY_ADDRESS_31337=0x0000000000000000000000000000000000000000
# TRUST_COMPOSE_FACTORY_ADDRESS_31337=0x0000000000000000000000000000000000000000
# GRAPH_LINEAGE_REGISTRY_ADDRESS_31337=0x0000000000000000000000000000000000000000

# Optimism RPC URL used for fetching blockchain data. Alchemy is recommended.
PONDER_RPC_URL_10=https://opt-mainnet.g.alchemy.com/v2/...
# PONDER_WS_URL_10=wss://opt-mainnet.g.alchemy.com/v2/...
# PONDER_START_BLOCK_10=142786328
# Ethereum Sepolia. Addresses/start block come from deployments/sepolia.json; no RPC URL is ever
# read from or written to that tracked manifest.
# DEPLOY_STAGE=production
# DEPLOY_TARGET=sepolia
# PONDER_RPC_URL_11155111=https://...
# PONDER_WS_URL_11155111=wss://...
# PONDER_START_BLOCK_11155111=
# WEIGHTED_FACTORY_ADDRESS_10=0x0000000000000000000000000000000000000000
# TRUST_COMPOSE_FACTORY_ADDRESS_10=0x0000000000000000000000000000000000000000
# GRAPH_LINEAGE_REGISTRY_ADDRESS_10=0x0000000000000000000000000000000000000000

# Required by `ponder start` in production. Change the writer schema on each release; keep the
# views schema stable so `ponder serve` can continue serving the last completed version.
# PONDER_DATABASE_SCHEMA=trustgraph_v1
# PONDER_VIEWS_SCHEMA=trust-graph

# Optional local ERC-8004 Identity Registry lifecycle fixture. Production ignores this and always
# indexes the official Optimism singleton from its deployment block.
# ERC8004_IDENTITY_REGISTRY_ADDRESS_31337=0x0000000000000000000000000000000000000000
# ERC8004_REPUTATION_REGISTRY_ADDRESS_31337=0x0000000000000000000000000000000000000000
# ERC8004_IPFS_GATEWAY=https://ipfs.io/ipfs/
# ERC8004_METADATA_TASKS_URL=http://127.0.0.1:42069/erc8004/metadata-tasks
# ERC8004_FEEDBACK_METADATA_TASKS_URL=http://127.0.0.1:42069/erc8004/feedback-metadata-tasks
# ERC8004_METADATA_INTERVAL_MS=3600000

# Polygon RPC URL used for fetching blockchain data. Alchemy is recommended.
PONDER_RPC_URL_137=https://polygon-mainnet.g.alchemy.com/v2/...

# Base RPC URL used for fetching blockchain data. Alchemy is recommended.
PONDER_RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/...

# Required: off-chain merkle/proof tables also use Postgres.
DATABASE_URL=postgresql://ponder:ponder@localhost:6432/ponder

# App origin whose Next.js caches are invalidated after indexed events. Defaults to
# http://127.0.0.1:3000 in DEV and https://trustgraph.network in PROD.
# FRONTEND_URL=http://127.0.0.1:3000

# IPFS
IPFS_GATEWAY=http://127.0.0.1:8080/ipfs/
# Independent raw-CID readers for strict EAS offchain v2 bundle verification. The indexer accepts
# bytes only when SHA-256 matches the onchain commitment; one healthy reader tolerates another's
# outage. Comma-separated and intentionally distinct from presentation-only IPFS_GATEWAY.
# EAS_OFFCHAIN_GATEWAYS=http://127.0.0.1:8080/ipfs/,https://backup.example/ipfs/
# Retry transient gateway propagation/outages inside the handler before the writer exits unhealthy.
# IPFS_FETCH_ATTEMPTS=5
# IPFS_FETCH_TIMEOUT_MS=10000
