{
  "name": "trustgraphs-indexer",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ensure-env-local": "if ! test -f .env.local; then cp .env.example .env.local; fi",
    "predev": "npm run ensure-env-local && npm run networks:link",
    "dev": "node scripts/launch-indexer.mjs dev",
    "prestart": "npm run ensure-env-local && npm run networks:link",
    "start": "node scripts/launch-indexer.mjs start",
    "preserve": "npm run networks:link",
    "serve": "node scripts/launch-indexer.mjs serve",
    "preflight": "node scripts/launch-indexer.mjs preflight",
    "networks:link": "node scripts/link-networks.mjs",
    "db": "ponder db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "codegen": "ponder codegen",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "metadata:erc8004": "tsx scripts/refresh-erc8004-metadata.ts",
    "metadata:erc8004:watch": "tsx scripts/refresh-erc8004-metadata.ts --watch",
    "nostr:validate-artifacts": "tsx scripts/validate-nostr-workspace-artifacts.ts",
    "programs:backfill": "tsx scripts/backfill-score-programs.ts",
    "typecheck": "node scripts/link-networks.mjs --allow-development-template && ponder codegen && tsc"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "@ponder/client": "^0.16.10",
    "@trustgraphs/eas-offchain-client": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "ponder": "^0.16.10",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.14"
  }
}
