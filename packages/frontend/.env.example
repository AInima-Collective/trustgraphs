# Fallbacks
RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/...
RPC_URL_10_0=https://opt-mainnet.g.alchemy.com/v2/...
RPC_URL_10_1=https://api.chandrastation.com/optimism?api_key=...

NEXT_PUBLIC_WEBSOCKET_URL_10=wss://...
# Sepolia frontend builds use DEPLOY_TARGET=sepolia and config.sepolia.json generated from the
# finalized release manifest. Browser RPC calls stay behind /api/rpc/11155111 and fail over
# between two independently operated upstreams. The public data and IPFS URLs are embedded into
# the generated config; public builds fail closed when either is absent or a placeholder.
# FRONTEND_URL=https://testnet.example.org
# PONDER_URL=https://ponder.testnet.example.org
# IPFS_GATEWAY_PUBLIC=https://gateway.example.org/ipfs/
# NEXT_PUBLIC_WEBSOCKET_URL_11155111=wss://...
# RPC_URL_11155111_0=https://...
# RPC_URL_11155111_1=https://...

# Where `POST /api/ipfs` pins a new network's description (the create wizard's only upload).
# Unset it locally: it defaults to the dev stack's kubo at http://127.0.0.1:5001/api/v0/add?pin=true,
# and to Pinata's uploads API otherwise. IPFS_PIN_API_KEY is the bearer token Pinata needs.
# IPFS_PIN_API=https://uploads.pinata.cloud/v3/files
# IPFS_PIN_API_KEY=...

# Optional proof-operator heartbeat. The frontend exposes only an allowlisted public projection;
# RPC/IPFS URLs, webhook URLs, local paths, alerts and unresolved journal entries are never sent
# to the browser. Prefer the URL when the operator is a separate service, or the path when both
# processes share a volume.
# OPERATOR_STATUS_URL=https://operator.example.com/status.json
# OPERATOR_STATUS_PATH=/var/run/trustgraph/operator/status.json

# Optional human-signed EAS relay. The browser creates the EIP-712 signature; this server key only
# pays gas and may submit zero-value attestations to explicitly allowlisted schemas. Put rate
# limiting in front of /api/eas-relay in production as well as the route's process-local guard.
# NEXT_PUBLIC_EAS_RELAY_ENABLED=false
# EAS_RELAY_CHAIN_ID=10
# EAS_RELAY_ADDRESS=0x4200000000000000000000000000000000000021
# EAS_RELAY_RPC_URL=https://...
# EAS_RELAY_PRIVATE_KEY=0x...
# EAS_RELAY_SCHEMA_ALLOWLIST=0x...,0x...

# Strict retained EAS v2 lane (separate from the delegated on-chain EAS relay above).
# Creation is offered only with 2–16 distinct public relayer addresses; these addresses receive
# ANCHORER_ROLE in the immutable factory transaction. URLs are browser-facing relay deployments
# backed by those keys. Gateways are independent raw-CID readers: the browser accepts bytes only
# after reproducing the onchain SHA-256 commitment and verifies the complete supported profile.
# NEXT_PUBLIC_EAS_OFFCHAIN_RELAYER_ADDRESSES=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222
# NEXT_PUBLIC_EAS_OFFCHAIN_RELAY_URLS=https://relay-a.example,https://relay-b.example
# NEXT_PUBLIC_EAS_OFFCHAIN_GATEWAYS=https://gateway-a.example/ipfs/,https://gateway-b.example/ipfs/
# Local browser/e2e override; defaults to http://localhost:8545.
# NEXT_PUBLIC_RPC_URL_31337=http://127.0.0.1:18545
# NEXT_PUBLIC_WEBSOCKET_URL_31337=ws://127.0.0.1:18545
